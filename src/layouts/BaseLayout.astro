---
import RevealMotion from '../components/RevealMotion.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Wix+Madefor+Display:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <RevealMotion />
  </body>
</html>

<style is:global>
  :root {
    --color-black: #000;
    --color-white: #fff;
    --color-gold-dark: #794d0c;
    --color-gold: #c88c1d;
    --color-gold-light: #fdf69f;
    --font-body: 'Plus Jakarta Sans', sans-serif;
    --font-display: 'Wix Madefor Display', sans-serif;
    --content-width: 1245px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--color-black); }
  body { margin: 0; background: var(--color-black); color: var(--color-white); font-family: var(--font-body); }
  a { color: inherit; text-decoration: none; }
  button, a { font: inherit; }

  .section-dot {
    animation: section-dot-pulse 3.2s ease-in-out infinite;
    transform-origin: center;
    will-change: opacity, filter, transform;
  }

  @keyframes section-dot-pulse {
    0%, 100% {
      opacity: .25;
      filter: brightness(.65) drop-shadow(0 0 0 rgba(200, 140, 29, 0));
      transform: scale(.92);
    }

    50% {
      opacity: 1;
      filter: brightness(1.45) drop-shadow(0 0 9px rgba(200, 140, 29, 1));
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-dot {
      animation-name: section-dot-light-pulse;
      animation-duration: 4.8s;
      transform: none;
    }
  }

  @keyframes section-dot-light-pulse {
    0%, 100% {
      opacity: .3;
      filter: brightness(.7) drop-shadow(0 0 0 rgba(200, 140, 29, 0));
    }

    50% {
      opacity: 1;
      filter: brightness(1.4) drop-shadow(0 0 9px rgba(200, 140, 29, 1));
    }
  }
</style>
