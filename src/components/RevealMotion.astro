<script>
  const revealElements = Array.from(
    document.querySelectorAll<HTMLElement>('[data-reveal]')
  );

  document.documentElement.classList.add('reveal-motion');

  revealElements.forEach((element) => {
    const delay = Number(element.dataset.revealDelay ?? 0);
    element.style.setProperty('--reveal-delay', `${delay}ms`);
  });

  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;

      requestAnimationFrame(() => {
        entry.target.classList.add('is-visible');
      });

      revealObserver.unobserve(entry.target);
    });
  }, {
    threshold: .14,
    rootMargin: '0px 0px -7% 0px'
  });

  revealElements.forEach((element) => revealObserver.observe(element));
</script>

<style is:global>
  html.reveal-motion [data-reveal] {
    opacity: 0;
    translate: 0 16px;
  }

  html.reveal-motion [data-reveal][data-reveal-from="right"] {
    translate: 28px 0;
  }

  html.reveal-motion [data-reveal].is-visible {
    animation: reveal-element .6s cubic-bezier(.2, .8, .2, 1) both;
    animation-delay: var(--reveal-delay, 0ms);
  }

  [data-hover-grow] {
    position: relative;
    scale: 1;
    transition:
      scale .35s cubic-bezier(.22, 1, .36, 1),
      box-shadow .25s ease,
      filter .25s ease;
  }

  [data-hover-grow]:hover {
    z-index: 1;
    scale: 1.02;
    filter: brightness(1.03);
    box-shadow: 0 10px 24px rgba(0, 0, 0, .18);
  }

  [data-hover-grow]:focus-within { scale: 1.02; }

  @keyframes reveal-element {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.reveal-motion [data-reveal] {
      translate: 0 5px;
    }

    html.reveal-motion [data-reveal][data-reveal-from="right"] {
      translate: 8px 0;
    }

    html.reveal-motion [data-reveal].is-visible {
      animation-duration: .35s;
    }

    [data-hover-grow] { transition-duration: .15s; }
    [data-hover-grow]:hover { scale: 1.01; }
  }
</style>
