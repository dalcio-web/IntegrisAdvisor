---
const assets = {
  governance: '/assets/about-governance.png',
  risks: '/assets/about-risks.jpg',
  audit: '/assets/about-audit.png',
  channel: '/assets/about-channel.png',
  linkedin: '/assets/linkedin.svg',
  dot: '/assets/section-dot.svg',
};

const services = [
  { title: 'Governança Corporativa e ESG', image: assets.governance, position: 'center' },
  { title: 'Gestão de Riscos Jurídicos e Reputacionais', image: assets.risks, position: 'center' },
  { title: 'Auditoria Interna\n(ISO 9001, 37001, 27001)', image: assets.audit, position: 'center' },
  { title: 'Canal de Denúncias e NR-1', image: assets.channel, position: 'center 70%' },
];
---

<section class="about" id="quem-somos" data-node-id="72:617">
  <div
    class="about__content"
    style="position: sticky; top: 120px; align-self: start; margin-top: 0;"
  >
    <div class="about__eyebrow">
      <img class="section-dot" src={assets.dot} alt="" width="15" height="15" />
      <span>Quem Somos e Nossos Pilares</span>
    </div>

    <h2>Protegendo o que você levou anos para construir.</h2>

    <p class="about__description">
      Somos Tânia e Ivone, consultoras especializadas em Compliance Empresarial e Proteção de Dados (LGPD). Com mais de 20 anos de experiência combinada, ajudamos empresários a construir negócios sólidos e blindados
    </p>

    <div class="about__people">
      <a
        href="https://www.linkedin.com/in/ivone-masago-52486825/"
        class="person-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn de Ivone Mariko"
      >
        <span>Ivone Mariko</span>
        <img src={assets.linkedin} alt="LinkedIn" width="20" height="20" />
      </a>
      <a
        href="https://www.linkedin.com/in/taniamariafigueiredo/"
        class="person-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn de Tânia Maria"
      >
        <span>Tânia Maria</span>
        <img src={assets.linkedin} alt="LinkedIn" width="20" height="20" />
      </a>
    </div>
  </div>

  <div class="about__services">
    {services.map((service, index) => (
      <article
        class="service-card"
        data-reveal
        data-reveal-from="right"
        data-reveal-delay={index * 120}
      >
        <img
          class="service-card__image"
          src={service.image}
          alt=""
          width="220"
          height="120"
          style={`object-position: ${service.position}`}
        />
        <h3>{service.title}</h3>
      </article>
    ))}
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 469px 604px;
    justify-content: space-between;
    width: min(calc(100% - 48px), 1239px);
    min-height: 690px;
    margin: 150px auto 0;
    scroll-margin-top: 110px;
  }

  .about__content {
    position: sticky;
    top: 120px;
    align-self: start;
    margin-top: 0;
  }

  .about__eyebrow {
    display: flex;
    align-items: center;
    gap: 20px;
    color: #d6a73e;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.55;
  }

  .about__eyebrow img { width: 15px; height: 15px; }

  h2 {
    width: 456px;
    margin: 32px 0 0;
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -1.44px;
  }

  .about__description {
    width: 469px;
    margin: 32px 0 0;
    font-size: 15px;
    line-height: 1.55;
  }

  .about__people { display: flex; gap: 10px; margin-top: 40px; }

  .person-link {
    position: relative;
    display: inline-flex;
    min-height: 55px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 38px;
    border-radius: 45px;
    background: linear-gradient(90deg, var(--color-gold-dark), var(--color-gold) 50%, var(--color-gold-light));
    box-shadow: inset 0 0 7px rgba(255, 255, 255, .35);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.55;
    opacity: .9;
    transition: filter .2s ease, transform .2s ease;
  }

  .person-link:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .person-link:focus-visible { outline: 2px solid var(--color-gold-light); outline-offset: 4px; }
  .person-link img { width: 20px; height: 20px; }

  .about__services { display: flex; flex-direction: column; gap: 30px; }

  .service-card {
    display: flex;
    width: 604px;
    height: 150px;
    align-items: center;
    gap: 32px;
    padding: 15px;
    border-left: 3px solid var(--color-gold);
    border-radius: 20px;
    background: rgba(255, 255, 255, .1);
  }

  .service-card__image {
    flex: 0 0 220px;
    width: 220px;
    height: 120px;
    border-radius: 17px;
    object-fit: cover;
  }

  h3 {
    width: 302px;
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -.72px;
    white-space: pre-line;
  }

  @media (max-width: 1060px) {
    .about { grid-template-columns: minmax(0, 469px) minmax(460px, 604px); gap: 48px; }
    .service-card { width: 100%; }
    .service-card__image { flex-basis: 42%; width: 42%; }
  }

  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; gap: 64px; }
    .about__content {
      position: static;
      margin-top: 0;
    }
    h2, .about__description { width: min(100%, 560px); }
    .about__services { width: 100%; }
  }

  @media (max-width: 620px) {
    .about { width: calc(100% - 32px); }
    h2 { font-size: 38px; }
    .about__people { flex-direction: column; }
    .person-link { width: 100%; }
    .service-card { height: auto; min-height: 150px; gap: 18px; }
    .service-card__image { flex-basis: 42%; width: 42%; height: 110px; }
    h3 { width: auto; font-size: 20px; }
  }
</style>
