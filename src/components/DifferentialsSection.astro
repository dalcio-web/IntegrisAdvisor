---
const dotAsset = '/assets/section-dot.svg';

const differentials = [
  {
    title: 'Especialização Real',
    description: 'Não somos generalistas, nosso foco total é Compliance e LGPD.',
  },
  {
    title: 'Entregáveis Concretos',
    description: 'Você recebe documentos prontos e processos estruturados, não apenas dicas.',
  },
  {
    title: 'Linguagem Acessível',
    description: 'Traduzimos a complexidade jurídica sem "juridiquês".',
  },
  {
    title: 'Sigilo Absoluto',
    description: 'Celebramos Acordo de confidencialidade antes de qualquer atividade.',
  },
];
---

<section class="differentials" id="diferenciais" data-node-id="72:618">
  <div class="differentials__eyebrow" data-reveal data-reveal-delay="0">
    <img class="section-dot" src={dotAsset} alt="" width="15" height="15" />
    <span>Segurança e Resultado</span>
  </div>

  <div class="differentials__intro">
    <h2 data-reveal data-reveal-delay="90">Por que a Integris Advisor é a escolha certa para blindar seu negócio?</h2>
    <p data-reveal data-reveal-delay="170">Nosso foco é trazer soluções práticas, sob medida e sem burocracia para que sua empresa cresça protegida e com total segurança jurídica.</p>
  </div>

  <div class="differentials__grid">
    {differentials.map((item, index) => (
      <article
        class="differential-card"
        data-reveal
        data-hover-grow
        data-reveal-delay={250 + index * 90}
      >
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .differentials {
    width: min(calc(100% - 48px), 1251px);
    margin: 150px auto 0;
    scroll-margin-top: 110px;
  }

  .differentials__eyebrow {
    display: flex;
    align-items: center;
    gap: 20px;
    color: #d6a73e;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.55;
  }

  .differentials__eyebrow img { width: 15px; height: 15px; }

  .differentials__intro {
    display: grid;
    grid-template-columns: 629px 371px;
    justify-content: space-between;
    align-items: start;
    margin-top: 20px;
  }

  .differentials__intro h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -1.14px;
  }

  .differentials__intro > p {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.55;
  }

  .differentials__grid {
    display: grid;
    grid-template-columns: repeat(4, 300px);
    gap: 17px;
    margin-top: 48px;
  }

  .differential-card {
    position: relative;
    display: flex;
    width: 300px;
    min-height: 150px;
    flex-direction: column;
    justify-content: center;
    padding: 30px 28px;
    border-radius: 25px;
    background: rgba(214, 167, 62, .8);
    scale: 1;
    transition:
      scale .25s cubic-bezier(.2, .8, .2, 1),
      box-shadow .25s ease,
      filter .25s ease;
  }

  .differential-card:hover {
    z-index: 1;
    scale: 1.02;
    filter: brightness(1.03);
    box-shadow: 0 18px 38px rgba(0, 0, 0, .22);
  }

  .differential-card:focus-within { scale: 1.02; }

  .differential-card h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.55;
  }

  .differential-card p {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.55;
  }

  @media (max-width: 1080px) {
    .differentials__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .differential-card { width: 100%; }
  }

  @media (max-width: 900px) {
    .differentials__intro { grid-template-columns: 1fr; gap: 28px; }
    .differentials__intro h2 { max-width: 629px; }
    .differentials__intro > p { max-width: 520px; }
  }

  @media (max-width: 620px) {
    .differentials { width: calc(100% - 32px); }
    .differentials__intro h2 { font-size: 34px; }
    .differentials__grid { grid-template-columns: 1fr; margin-top: 38px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .differential-card { transition-duration: .15s; }
    .differential-card:hover { scale: 1.01; }
  }
</style>
