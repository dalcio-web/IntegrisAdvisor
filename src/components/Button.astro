---
interface Props {
  href: string;
  variant?: 'solid' | 'outlined';
  class?: string;
}
const { href, variant = 'solid', class: className } = Astro.props;
---
<a class:list={['button', `button--${variant}`, className]} href={href}><slot /></a>

<style>
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 55px;
    padding: 15px 38px;
    border-radius: 45px;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.55;
    background: linear-gradient(90deg, var(--color-gold-dark), var(--color-gold) 50%, var(--color-gold-light));
    background-size: 130% 100%;
    background-position: left center;
    box-shadow: inset 0 0 7px rgba(255,255,255,.35);
    white-space: nowrap;
    cursor: pointer;
    transition: transform .2s ease, filter .2s ease, background-position .35s ease, box-shadow .2s ease;
  }

  .button:hover {
    transform: translateY(-1px);
    filter: brightness(1.06) saturate(1.03);
    background-position: right center;
    box-shadow: inset 0 0 10px rgba(255,255,255,.5), 0 8px 24px rgba(200,140,29,.3);
  }

  .button:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 4px;
  }

  .button:active {
    transform: translateY(0) scale(.98);
    filter: brightness(.96);
  }

  .button--outlined {
    border: 1.5px solid #fff;
    box-shadow: inset 0 0 7px 1px rgba(255,255,255,.45), 0 0 0 6px rgba(200,140,29,.3);
  }

  .button--outlined:hover {
    box-shadow: inset 0 0 10px 1px rgba(255,255,255,.65), 0 0 0 6px rgba(200,140,29,.42), 0 10px 28px rgba(200,140,29,.28);
  }

  @media (prefers-reduced-motion: reduce) {
    .button { transition: none; }
  }
</style>
