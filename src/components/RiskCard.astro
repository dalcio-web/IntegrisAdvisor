---
interface Props {
  icon: string;
  title: string;
  framed?: boolean;
  solidFrame?: boolean;
  iconWidth?: number;
  iconHeight?: number;
  revealDelay?: number;
}

const { icon, title, framed = false, solidFrame = false, iconWidth, iconHeight, revealDelay } = Astro.props;
const resolvedIconWidth = iconWidth ?? (framed ? 40 : 65);
const resolvedIconHeight = iconHeight ?? (framed ? 40 : 65);
---

<article
  class="risk-card"
  tabindex="0"
  data-reveal={revealDelay !== undefined}
  data-reveal-delay={revealDelay}
>
  <div class="risk-card__heading">
    <span class:list={['risk-card__icon', { 'risk-card__icon--framed': framed, 'risk-card__icon--solid': solidFrame }]}> 
      <img
        src={icon}
        alt=""
        width={resolvedIconWidth}
        height={resolvedIconHeight}
        style={`width: ${resolvedIconWidth}px; height: ${resolvedIconHeight}px;`}
      />
    </span>
    <h3>{title}</h3>
  </div>
  <p><slot /></p>
</article>

<style>
  .risk-card {
    min-height: 254px;
    padding: 49px 42px;
    border-bottom: 3px solid transparent;
    border-radius: 25px;
    background: transparent;
    outline: none;
    cursor: default;
    transition: background-color .25s ease, border-color .25s ease, box-shadow .25s ease;
  }

  .risk-card:hover,
  .risk-card:focus-visible {
    border-bottom-color: var(--color-gold-dark);
    background: rgba(255, 255, 255, .1);
    box-shadow: inset 0 -1px 0 var(--color-gold-light);
  }

  .risk-card__heading {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .risk-card__icon {
    display: grid;
    flex: 0 0 65px;
    width: 65px;
    height: 65px;
    place-items: center;
  }

  .risk-card__icon--framed {
    overflow: hidden;
    border-radius: 15px;
    background: #201605;
    background-image: none;
    box-shadow: none;
    filter: none;
  }

  .risk-card__icon--solid {
    overflow: hidden;
    border-radius: 15px;
    background: #201605;
    box-shadow: none;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .risk-card__icon--framed img {
    width: 40px;
    height: 40px;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -.72px;
    white-space: pre-line;
  }

  p {
    margin: 25px 0 0;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .risk-card { padding: 32px; }
  }

  @media (max-width: 560px) {
    .risk-card { min-height: auto; padding: 28px 24px; }
    .risk-card__heading { gap: 18px; }
    h3 { font-size: 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .risk-card { transition: none; }
  }
</style>
